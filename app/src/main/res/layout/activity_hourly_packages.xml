<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FA">

    <!-- لیست بسته‌های ساعتی (بدون هدر و تب‌های تکراری) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- بسته اول: 400 ام بی ساعتی -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EF6C00"
                        android:text="400 ام بی ساعتی"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="12dp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 افغانی"
                            android:textColor="#0288D1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="#E1F5FE"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="بسته 400 ام بی اینترنت برای یک ساعت.\nبرای فعال سازی H1 و برای غیرفعال سازی PH1 را به 3378 ارسال نمائید.\nبرای بررسی موجودی 605 را به 606 ارسال نمائید."
                            android:textColor="#2D3748"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/btnActivate1"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2E7D32"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnCheck1"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="چک بیلانس"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#00838F"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnDeactivate1"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="غیر فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#C62828"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- بسته دوم: 512 ام بی ساعتی -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EF6C00"
                        android:text="512 ام بی ساعتی"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="12dp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 افغانی"
                            android:textColor="#0288D1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="#E1F5FE"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="بسته 512 ام بی اینترنت برای دو ساعت.\nبرای فعال سازی H2 و برای غیرفعال سازی PH2 را به 3378 ارسال نمائید.\nبرای بررسی موجودی 605 را به 606 ارسال نمائید."
                            android:textColor="#2D3748"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/btnActivate2"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2E7D32"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnCheck2"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="چک بیلانس"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#00838F"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnDeactivate2"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="غیر فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#C62828"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- بسته سوم: 1 گیگابایت ساعتی -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EF6C00"
                        android:text="1 گیگابایت ساعتی"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="12dp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25 افغانی"
                            android:textColor="#0288D1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="#E1F5FE"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="بسته 1 گیگابایت اینترنت برای 3 ساعت.\nبرای فعال سازی H3 و برای غیرفعال سازی PH3 را به 3378 ارسال نمائید.\nبرای بررسی موجودی 605 را به 606 ارسال نمائید."
                            android:textColor="#2D3748"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/btnActivate3"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2E7D32"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnCheck3"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="چک بیلانس"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#00838F"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnDeactivate3"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="غیر فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#C62828"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- بسته چهارم: 2 گیگابایت ساعتی -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EF6C00"
                        android:text="2 گیگابایت ساعتی"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="12dp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="40 افغانی"
                            android:textColor="#0288D1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="#E1F5FE"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="بسته 2 گیگابایت اینترنت برای 6 ساعت.\nبرای فعال سازی H4 و برای غیرفعال سازی PH4 را به 3378 ارسال نمائید.\nبرای بررسی موجودی 605 را به 606 ارسال نمائید."
                            android:textColor="#2D3748"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/btnActivate4"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2E7D32"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnCheck4"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="چک بیلانس"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#00838F"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnDeactivate4"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="غیر فعال سازی"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#C62828"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
