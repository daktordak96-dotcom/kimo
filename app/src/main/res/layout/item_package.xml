<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#F5F5F5">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <!-- هدر نارنجی رنگ برای عنوان بسته -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF9800"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtPackageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عنوان بسته"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- بدنه کارت -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- کادر قیمت آبی کم‌رنگ -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="#E1F5FE"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtPackagePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="قیمت"
                        android:textColor="#0288D1"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- توضیحات کامل بسته -->
                <TextView
                    android:id="@+id/txtPackageDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="توضیحات بسته..."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- ۳ دکمه رنگی (فعال‌سازی، بیلانس، غیرفعال‌سازی) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layoutDirection="ltr">

                    <!-- غیرفعال‌سازی (قرمز) -->
                    <Button
                        android:id="@+id/btnDeactivate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:backgroundTint="#C62828"
                        android:text="غیر فعال‌سازی"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- چک بیلانس (آبی) -->
                    <Button
                        android:id="@+id/btnCheck"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:backgroundTint="#00838F"
                        android:text="چک بیلانس"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- فعال‌سازی (سبز) -->
                    <Button
                        android:id="@+id/btnActivate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:backgroundTint="#2E7D32"
                        android:text="فعال‌سازی"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
