<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="16dp">

    <!-- هدر منو (عنوان و دکمه بستن) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="خدمات سیمکارت‌های افغانستان"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A202C" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ورژن 5.4"
        android:textSize="13sp"
        android:textColor="#718096"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="8dp" />

    <!-- گزینه ۱: امتیاز به برنامه -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F7FAFC"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/btn_star_big_on" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ما را درجه بندی کنید"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D3748"
                android:layout_marginStart="12dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_media_play" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- گزینه ۲: کانال تلگرام -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTelegram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F7FAFC"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_send" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="به کانال تلگرام ما بپیوندید"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2D3748"
                android:layout_marginStart="12dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_media_play" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- بخش انتخاب زبان (فارسی و انگلیسی) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F7FAFC"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="زبان / Language"
            android:textStyle="bold"
            android:textColor="#2D3748"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtFarsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فارسی"
            android:textColor="#0288D1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- فوتر اطلاعات سازنده (شامل ایمیل و آیدی تلگرام جدید) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Abdoljabar Akrami"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#718096" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram ID: @Akrami_Code"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0288D1"
            android:paddingTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="strimosafr@gmail.com"
            android:textSize="11sp"
            android:textColor="#A0AEC0"
            android:paddingTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Packages Version: 29"
            android:textSize="11sp"
            android:textColor="#A0AEC0"
            android:paddingTop="2dp" />
    </LinearLayout>

</LinearLayout>
